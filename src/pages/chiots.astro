---
import ActivityDetails from '../components/ActivityDetails.astro'
import ActivityIntroduction from '../components/ActivityIntroduction.astro'
import JoinUs from '../components/JoinUs.astro'
import Layout from '../layouts/MainLayout.astro'

const puppiesIntroduction = "L'école du chiot c'est trop bien"
const puppiesDetails =
	"Plus de détails sur ce qu'on fait en chiots, potentiellement avec photos, liste de choses travaillées et description de la méthode"
---

<Layout>
	<main>
		<ActivityIntroduction title='Ecole des chiots' text={puppiesIntroduction} />
		<ActivityDetails title="Plus d'explications" text={puppiesDetails} />
		<JoinUs />
	</main>
</Layout>
