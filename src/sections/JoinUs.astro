---
import Shop from '../icons/shop.astro'
import SurpriseAccent from '../icons/surprise-accent.astro'
import Button from '../components/atoms/Button.astro'
import PracticalInfo from '../components/PracticalInfo.astro'
---

<section class='join-us'>
	<div class='how'>
		<h2>Comment rejoindre le club ?</h2>
		<div class='steps'>
			<div class='step'>
				<span class='badge'>1</span>
				<h3>Venez découvrir <span class='accent'>sans rendez-vous</span> !</h3>
				<p>
					Passez nous voir <em
						>un samedi pour observer ou poser vos questions</em
					>
				</p>
			</div>
			<div class='step'>
				<span class='badge'>2</span>
				<h3>Participez à une <span class='accent'>séance gratuite</span> !</h3>
				<p>
					Testez une séance avec votre chien pour voir si les cours vous
					conviennent.
				</p>
			</div>
			<div class='step'>
				<span class='badge'>3</span>
				<h3>Préparez votre inscription !</h3>
				<p>Rejoignez le club et profitez des activités toute l'année.</p>
			</div>
		</div>
		<div class='checklist'>
			<div class='illu'>
				<Shop class='shop' />
			</div>
			<div class='text'>
				<h4>A prévoir pour l'inscription et le cours d'essai</h4>
				<ul>
					<li>Carnet de vaccination</li>
					<li>Laisse (1m80 non enrouleuse)</li>
					<li>Collier plat</li>
					<li>Friandises et jouet</li>
					<li>Sacs à crottes</li>
					<li>Un grand sourire</li>
				</ul>
			</div>
			<div class='surprise'>
				<SurpriseAccent class='surprise-icon' />
			</div>
		</div>
	</div>
	<PracticalInfo />
</section>

<style scoped lang='scss'>
	@use '../styles/colors';
	@use '../styles/borders';
	@use '../styles/gutters';
	@use '../styles/fonts';

	.join-us {
		width: gutters.$small-max-width;
		margin: gutters.$extra-large auto;
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: gutters.$extra-extra-large;
		.how {
			border: borders.$standard;
			padding: gutters.$extra-large;
			border-radius: borders.$radius;
			display: flex;
			flex-direction: column;
			gap: gutters.$large;
			h2 {
				font-family: fonts.$family-title;
				font-size: fonts.$title;
				color: colors.$main;
			}
			.steps {
				display: grid;
				grid-template-columns: 1fr 1fr 1fr;
				gap: gutters.$large;
				.step {
					display: flex;
					flex-direction: column;
					gap: gutters.$small;
					.badge {
						background-color: colors.$main;
						width: 2rem;
						height: 2rem;
						border-radius: 100%;
						color: colors.$white;
						display: flex;
						justify-content: center;
						align-items: center;
						font-family: fonts.$family-title;
					}
					h3 {
						font-family: fonts.$family-title;
						font-size: fonts.$subtitle;
						font-weight: 400;
						.accent {
							color: colors.$accent;
						}
					}
					em {
						font-weight: bold;
						font-style: normal;
					}
				}
			}
			.checklist {
				display: flex;
				gap: gutters.$large;
				background-color: colors.$main;
				padding: gutters.$large;
				border-radius: borders.$radius-small;
				color: colors.$white;
				.illu {
					width: 4rem;
				}
				.text {
					display: flex;
					flex-direction: column;
					gap: gutters.$large;
					flex: 1;
					h4 {
						font-family: fonts.$family-title;
						font-size: fonts.$subtitle;
						line-height: fonts.$subtitle;
						font-weight: 400;
					}
					ul {
						margin-left: gutters.$large;
					}
				}
				.surprise {
					width: 5rem;
					:deep(.surprise-icon) {
						width: 5rem;
						height: 5rem;
					}
				}
			}
		}
	}

	@media (max-width: 1440px) {
		.join-us {
			width: calc(100% - 2rem);
			margin-inline: 1rem;
			display: flex;
			flex-direction: column;
			gap: gutters.$extra-large;
			.how {
				padding: gutters.$normal;
				h2 {
					font-size: fonts.$title-mobile;
					line-height: fonts.$title-mobile;
				}
				.steps {
					display: flex;
					flex-direction: column;
					p {
						text-align: justify;
					}
				}
				.checklist {
					// bag icon and orange splash side by side on top, text below
					display: grid;
					grid-template-columns: auto 1fr;
					grid-template-areas:
						'illu surprise'
						'text text';
					column-gap: gutters.$normal;
					row-gap: gutters.$normal;
					.illu {
						grid-area: illu;
					}
					.text {
						grid-area: text;
					}
					.surprise {
						grid-area: surprise;
						align-self: center;
						justify-self: start;
						width: 3.5rem;
						:global(.surprise-icon) {
							display: block;
							width: 100%;
							height: auto;
						}
					}
				}
			}
		}
	}
</style>
