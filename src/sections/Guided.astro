---
import LetMeGuideYou from '../components/LetMeGuideYou.astro'
---

<section class='guided'>
	<div class='content'>
		<LetMeGuideYou class='guided-card' />
	</div>
</section>

<style scoped lang='scss'>
	@use '../styles/colors';
	@use '../styles/gutters';

	.guided {
		display: flex;
		padding: 5rem;
		width: 100%;
		background-image: url('/images/le-club-au-poil-1.webp');
		background-size: cover;
		background-position: center 30%;
		.content {
			width: gutters.$small-max-width;
			margin: auto;
			:global(.guided-card) {
				width: 35rem;
			}
		}
	}

	@media (max-width: 1440px) {
		.guided {
			// photo shown whole at the top, card full width overlapping its bottom edge
			padding: 10rem gutters.$normal gutters.$normal;
			background-size: 100% auto;
			background-position: top;
			background-repeat: no-repeat;
			background-color: colors.$background;
			.content {
				width: 100%;
				:global(.guided-card) {
					width: 100%;
				}
			}
		}
	}
</style>
