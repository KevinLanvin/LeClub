---
import Surprise from '../icons/surprise.astro'
---

<section class='walks'>
	<img src='/images/walks.jpg' alt='' class='walks-illustration' />
	<div class='content'>
		<h2>
			<span class='orange'>Balades canines</span> : apprendre en situation réelle
		</h2>
		<p>
			Pour apprendre les bases utiles tous les jours : rappel, marche en laisse.
			Des balades encadrées pour travailler dans un cadre plus naturel.
		</p>
		<div class='list'>
			<h3>Ce que vous allez travailler</h3>
			<ul>
				<li>La marche en laisse</li>
				<li>Le comportement en extérieur</li>
				<li>La gestions des interactions</li>
			</ul>
		</div>
	</div>
	<Surprise class='surprise' />
</section>

<style lang='scss' scoped>
	@use '../styles/colors';
	@use '../styles/fonts';
	@use '../styles/gutters';
	@use '../styles/borders';
	@use '../styles/shadows';

	.walks {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: gutters.$extra-extra-large;
		padding-top: 5rem;
		padding-bottom: 10rem;
		background-color: colors.$main-lighter;
		position: relative;
		.content {
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 40rem;
			margin: auto;
			text-align: center;
			gap: gutters.$extra-large;
			h2 {
				color: colors.$main;
				font-family: fonts.$family-title;
				font-weight: 400;
				font-size: fonts.$title;
				line-height: fonts.$title;
				width: 80%;
				.orange {
					color: colors.$accent;
				}
			}
			.list {
				align-self: start;
				display: flex;
				flex-direction: column;
				gap: gutters.$large;
				h3 {
					text-align: start;
				}
				ul {
					list-style: none;
					display: flex;
					flex-direction: column;
					gap: gutters.$large;
					li {
						display: flex;
						align-items: center;
						gap: gutters.$small;
						width: max-content;
						&::before {
							content: url('../icons/check-orange.svg');
							display: block;
							height: 2rem;
						}
					}
				}
			}
		}
		.walks-illustration {
			width: 60rem;
			aspect-ratio: 2.5;
			object-fit: cover;
			object-view-box: inset(10%);
			border-radius: borders.$radius;
		}
		:global(.surprise) {
			position: absolute;
			bottom: 5rem;
			right: 15rem;
			transform: rotate(50deg);
		}
	}
	@media (max-width: 1440px) {
		.walks {
			.content {
				width: gutters.$mobile-width;
				h2 {
					font-size: fonts.$title-mobile;
					line-height: fonts.$title-mobile;
				}
				.list {
					h3 {
						font-size: 1rem;
						line-height: 1rem;
					}
					ul {
						li {
							width: 100%;
							word-wrap: normal;
						}
					}
				}
			}
			.walks-illustration {
				width: gutters.$mobile-width;
			}
			:global(.surprise) {
				position: absolute;
				width: 3rem;
				bottom: 3rem;
				right: 5rem;
				transform: rotate(50deg);
			}
		}
	}
</style>
