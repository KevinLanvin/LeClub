---
import NoJudgement from '../components/NoJudgement.astro'
import LogoOutline from '../components/LogoOutline.astro'
---

<section id='education' class='education'>
	<LogoOutline class='education-logo' />
	<div class='content'>
		<h2>
			<span class='orange'>Education canine</span> : améliorer le quotidien
		</h2>
		<p>
			Pour apprendre les bases utiles tous les jours : rappel, marche en laisse
			et renforcer le lien avec son chien
		</p>
		<div class='list'>
			<h3>Ce que vous allez travailler</h3>
			<ul>
				<li>La communication maître-chien</li>
				<li>L'attention du chien</li>
				<li>Les situations du quotidien</li>
				<li>Des jeux inutiles donc indispensables</li>
			</ul>
		</div>
		<div class='no-judgement'>
			<NoJudgement class:list='no-judgement-card' />
		</div>
	</div>
</section>

<style lang='scss' scoped>
	@use '../styles/colors';
	@use '../styles/fonts';
	@use '../styles/gutters';
	@use '../styles/borders';
	@use '../styles/shadows';

	.education {
		padding-top: 10rem;
		margin-top: -5rem;
		margin-bottom: -5rem;
		background: colors.$blue-lighter;
		position: relative;
		// the card below overlaps the next section, so only clip sideways
		overflow-x: clip;
		> :global(.education-logo) {
			width: 70rem;
			top: 18%;
			left: -35rem;
			transform: rotate(-25deg);
		}
		.content {
			position: relative;
			z-index: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 40rem;
			margin: auto;
			text-align: center;
			gap: gutters.$extra-large;
			h2 {
				color: colors.$main;
				font-family: fonts.$family-title;
				font-weight: 400;
				font-size: fonts.$title;
				line-height: fonts.$title;
				width: 80%;
				.orange {
					color: colors.$accent;
				}
			}
			.list {
				align-self: start;
				display: flex;
				flex-direction: column;
				gap: gutters.$large;
				h3 {
					text-align: start;
				}
				ul {
					list-style: none;
					display: flex;
					flex-direction: column;
					gap: gutters.$large;
					li {
						display: flex;
						align-items: center;
						gap: gutters.$small;
						width: max-content;
						&::before {
							content: url('../icons/check-orange.svg');
							display: block;
							height: 2rem;
						}
					}
				}
			}
			.no-judgement {
				padding: gutters.$extra-extra-large;
				background-image: url('/images/education-school.webp');
				background-size: cover;
				background-position: center;
				border-radius: borders.$radius;
				width: gutters.$max-width;
				margin-top: 5rem;
				display: flex;
				justify-content: end;
				:global(.no-judgement-card) {
					width: 40rem;
				}
				margin-bottom: -15rem;
			}
		}
	}

	@media (max-width: 1440px) {
		.education {
			padding-top: 8rem;
			padding-bottom: gutters.$extra-large;
			margin-top: -3rem;
			margin-bottom: -3rem;
			> :global(.education-logo) {
				width: 32rem;
				left: -16rem;
			}
			.content {
				width: gutters.$mobile-width;
				h2 {
					font-size: fonts.$title-mobile;
					line-height: fonts.$title-mobile;
				}
				.list {
					h3 {
						font-size: 1rem;
						line-height: 1rem;
					}
					ul {
						li {
							width: 100%;
							word-wrap: normal;
						}
					}
				}
				.no-judgement {
					// the empty meadow on the right is only useful on desktop: on mobile the photo is its own
					// band, zoomed on the dog, with the card slightly overlapping its bottom edge
					width: 100%;
					padding: 0;
					margin-top: gutters.$large;
					margin-bottom: 0;
					background: none;
					border-radius: 0;
					flex-direction: column;
					justify-content: flex-start;
					&::before {
						content: '';
						display: block;
						height: 19rem;
						background-image: url('/images/education-school.webp');
						background-size: auto 100%;
						background-position: left top;
						background-repeat: no-repeat;
						border-radius: borders.$radius;
					}
					:global(.no-judgement-card) {
						width: 100%;
						margin-top: -2rem;
						position: relative;
					}
				}
			}
		}
	}
</style>
