---
import NoJudgement from '../components/NoJudgement.astro'
---

<section class='education'>
	<div class='content'>
		<h2>
			<span class='orange'>Education canine</span> : améliorer le quotidien
		</h2>
		<p>
			Pour apprendre les bases utiles tous les jours : rappel, marche en laisse
			et renforcer le lien avec son chien
		</p>
		<div class='list'>
			<h3>Ce que vous allez travailler</h3>
			<ul>
				<li>La communication maître-chien</li>
				<li>L'attention du chien</li>
				<li>Les situations du quotidien</li>
				<li>Des jeux inutiles donc indispensables</li>
			</ul>
		</div>
		<div class='no-judgement'>
			<NoJudgement class:list='no-judgement-card' />
		</div>
	</div>
</section>

<style lang='scss' scoped>
	@use '../styles/colors';
	@use '../styles/fonts';
	@use '../styles/gutters';
	@use '../styles/borders';
	@use '../styles/shadows';

	.education {
		padding-top: 10rem;
		margin-top: -5rem;
		margin-bottom: -5rem;
		background: colors.$blue-lighter;
		.content {
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 40rem;
			margin: auto;
			text-align: center;
			gap: gutters.$extra-large;
			h2 {
				color: colors.$main;
				font-family: fonts.$family-title;
				font-weight: 400;
				font-size: fonts.$title;
				line-height: fonts.$title;
				width: 80%;
				.orange {
					color: colors.$accent;
				}
			}
			.list {
				align-self: start;
				display: flex;
				flex-direction: column;
				gap: gutters.$large;
				h3 {
					text-align: start;
				}
				ul {
					list-style: none;
					display: flex;
					flex-direction: column;
					gap: gutters.$large;
					li {
						display: flex;
						align-items: center;
						gap: gutters.$small;
						width: max-content;
						&::before {
							content: url('../icons/check-orange.svg');
							display: block;
							height: 2rem;
						}
					}
				}
			}
			.no-judgement {
				padding: gutters.$extra-extra-large;
				background-image: url('/images/education-school.png');
				background-size: cover;
				background-position: center;
				border-radius: borders.$radius;
				width: gutters.$max-width;
				margin-top: 5rem;
				display: flex;
				justify-content: end;
				:global(.no-judgement-card) {
					width: 40rem;
				}
				margin-bottom: -15rem;
			}
		}
	}

	@media (max-width: 1440px) {
		.education {
			padding-top: 8rem;
			margin-top: -3rem;
			margin-bottom: -3rem;
			.content {
				width: gutters.$mobile-width;
				h2 {
					font-size: fonts.$title-mobile;
					line-height: fonts.$title-mobile;
				}
				.list {
					h3 {
						font-size: 1rem;
						line-height: 1rem;
					}
					ul {
						li {
							width: 100%;
							word-wrap: normal;
						}
					}
				}
				.no-judgement {
					.education-school-illustration {
						width: 100%;
						margin-top: gutters.$large;
					}
				}
			}
		}
	}
</style>
