---
import GotQuestions from '../components/GotQuestions.astro'

// `ratio` = width / height of the background image: on desktop the section keeps that
// ratio so the whole photo stays visible (no crop) whatever the screen width.
const { backgroundImage = '/images/sunny-brouette.webp', ratio = '2400 / 1139' } = Astro.props
---

<section class='contact-cta' style={`background-image: url('${backgroundImage}'); --ratio: ${ratio};`}>
	<div class='content'>
		<GotQuestions class='contact-cta-card' />
	</div>
</section>

<style scoped lang='scss'>
	@use '../styles/gutters';

	.contact-cta {
		display: flex;
		padding: 5rem;
		width: 100%;
		background-size: cover;
		background-position: center;
		.content {
			width: gutters.$small-max-width;
			margin: auto;
			display: flex;
			justify-content: end;
			:global(.contact-cta-card) {
				width: 35rem;
			}
		}
	}

	@media (min-width: 1441px) {
		.contact-cta {
			aspect-ratio: var(--ratio);
		}
	}

	@media (max-width: 1440px) {
		.contact-cta {
			padding: gutters.$normal;
			.content {
				width: 100%;
				:global(.contact-cta-card) {
					width: 100%;
				}
			}
		}
	}
</style>
