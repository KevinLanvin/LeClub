---
import Star from '../icons/star.astro'
import Location from '../icons/location.astro'
import Button from '../components/atoms/Button.astro'
import Gift from '../icons/gift.astro'
import Surprise from '../icons/surprise.astro'
---

<section class='introduction'>
	<div class='main'>
		<h3>Club associatif d’éducation canine à Teteghem</h3>
		<h1>
			Un club canin pour <br /><span class='orange'>apprendre, partager</span
			><br /> & évoluer avec son chien
		</h1>
		<p>
			À Téteghem, rejoignez un club convivial où chiens et maîtres progressent
			ensemble, à leur rythme.
		</p>
		<div class='actions'>
			<Button>Découvrir les activités</Button>
			<Button inverted>Consulter le planning</Button>
		</div>
	</div>
	<div class='illustration'>
		<img src='/images/intro.png' alt='Dog' />
		<Surprise class='surprise' />
	</div>
	<div class='informations'>
		<div class='information'>
			<span class='icon'><Location /></span>
			<span class='title'>A Teteghem</span>
			<span class='details'>Dans le dunkerquois</span>
		</div>
		<div class='information'>
			<span class='icon'><Star /></span>
			<span class='title'>Pour chiots et chiens adultes</span>
			<span class='details'>(en cours collectifs)</span>
		</div>
		<div class='information'>
			<span class='icon'><Gift /></span>
			<span class='title'>Ambiance conviviale</span>
			<span class='details'>fait partie de la Saint Hubert du Nord</span>
		</div>
	</div>
	<div class='logo'></div>
</section>

<style lang='scss' scoped>
	@use '../styles/colors';
	@use '../styles/gutters';
	@use '../styles/borders';
	@use '../styles/shadows';
	@use '../styles/fonts';

	.introduction {
		max-width: gutters.$small-max-width;
		margin: auto;
		color: colors.$text;
		margin-bottom: 10rem;
		position: relative;
		.main {
			padding: 10rem 0;
			display: flex;
			flex-direction: column;
			gap: gutters.$normal;
			max-width: 50%;
			h3 {
				text-transform: uppercase;
				font-size: 1rem;
				font-weight: 300;
				letter-spacing: 0;
				font-family: Poppins;
			}
			h1 {
				color: colors.$main;
				font-family: fonts.$family-title;
				font-weight: 400;
				font-size: fonts.$title;
				line-height: fonts.$title;
				.orange {
					color: colors.$accent;
				}
			}
		}
		.actions {
			display: flex;
			gap: gutters.$normal;
		}
		.illustration {
			width: 80%;
			position: absolute;
			right: 1rem;
			bottom: 0;
			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			:global(.surprise) {
				position: absolute;
				top: 37%;
				right: 8%;
			}
		}
		.logo {
			display: none;
			position: absolute;
			top: 0;
			right: 0;
			transform: rotate(-36deg) translate(20%, 45%);
			width: calc(1.3 * gutters.$max-width);
			aspect-ratio: calc(884 / 430);
			z-index: -1;
			background-color: colors.$main;
			mask: url('/images/logo-no-text.png');
			mask-repeat: no-repeat;
			mask-position: center;
			mask-size: contain;
		}
		.informations {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: gutters.$small;
			background: colors.$white;
			padding: gutters.$small;
			border-radius: borders.$radius;
			box-shadow: shadows.$card;
			position: absolute;
			bottom: 0;
			transform: translateY(50%);
			left: 0;
			width: 100%;
			.information {
				padding: gutters.$normal;
				border-radius: borders.$radius;
				display: grid;
				grid-template-areas:
					'icon title'
					'icon text';
				grid-template-columns: 3rem 1fr;
				column-gap: gutters.$small;
				&:nth-child(1) {
					background-color: colors.$main-lighter;
				}
				&:nth-child(2) {
					background-color: colors.$main-light;
				}
				&:nth-child(3) {
					background-color: colors.$red;
				}
				.icon {
					grid-area: icon;
					width: 3rem;
					height: 3rem;
				}
				.title {
					grid-area: title;
					font-weight: bold;
				}
				.details {
					grid-area: text;
				}
			}
		}
	}

	@media (max-width: 1440px) {
		.introduction {
			max-width: 100%;
			margin-bottom: 5rem;
			padding-inline: gutters.$normal;
			.main {
				padding: gutters.$extra-extra-large;
				max-width: 100%;
				h1 {
					font-size: fonts.$title-mobile;
					line-height: fonts.$title-mobile;
				}
				.actions {
					flex-direction: column;
				}
			}
			.informations {
				position: relative;
				gap: gutters.$normal;
				max-width: 100%;
				left: unset;
				bottom: unset;
				transform: unset;
				grid-template-columns: 1fr;
				grid-template-rows: repeat(3, 1fr);
			}
			.illustration {
				position: relative;
				right: unset;
				bottom: unset;
				width: 100%;
				img {
					display: block;
				}
				:global(.surprise) {
					position: absolute;
					top: 0;
					right: 0;
					width: 20%;
				}
			}
			.logo {
				width: 80%;
				top: 8rem;
			}
		}
	}
</style>
