---
import { getCollection } from 'astro:content'

const entries = await getCollection('courses')
const { date, courses } = entries[0].data
---

<section class='courses'>
	<h2>Le planning des prochains cours</h2>
	<h3>{date.toLocaleDateString('fr-FR', { dateStyle: 'full' })}</h3>
	<table>
		<thead>
			<tr>
				<th>Horaire</th>
				<th>Niveau</th>
				<th>Moniteurs</th>
			</tr>
		</thead>
		<tbody>
			{
				courses.map((course) => (
					<tr>
						<td>{course.hour_interval}</td>
						<td>{course.courseName}</td>
						<td>{course.teachers.join(' & ')}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</section>

<style scoped lang='scss'>
	@use '../styles/colors';

	.courses {
		background-color: colors.$main-light;
	}
</style>
