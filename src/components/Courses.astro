---
import { getCollection } from 'astro:content'
import HeaderAfter from '../icons/header-after.astro'
import HeaderBefore from '../icons/header-before.astro'
import type { coursesValues } from '../content/config'
import Button from './atoms/Button.astro'
import LogoOutline from './LogoOutline.astro'

const entries = await getCollection('courses')
// one block per day with courses, in chronological order
const days = [...entries[0].data.days].sort(
	(a, b) => a.date.getTime() - b.date.getTime(),
)
const formatDate = (date: Date) =>
	date.toLocaleDateString('fr-FR', {
		weekday: 'long',
		day: 'numeric',
		month: 'long',
	})
const capitalize = ([first, ...rest]: string): string =>
	`${first.toUpperCase()}${rest.join('')}`

const courseColor: Record<(typeof coursesValues)[number], string> = {
	'2 - 4 mois': 'green',
	'4 - 6 mois': 'green',
	'6 mois et +': 'green',
	Rééducation: 'blue',
	Intermédiaire: 'orange',
	Avancé: 'red',
	CSAU: 'red',
	Secrétariat: 'neutral',
}

const monitorAvatars = {
	sandrine: 'monitrice.webp',
	laurent: 'monitor.webp',
	fred: 'monitor.webp',
	lena: 'monitor.webp',
	nathalie: 'monitor.webp',
	yohann: 'monitor.webp',
	marie: 'monitor.webp',
	patrick: 'monitor.webp',
	anthony: 'monitor.webp',
	valerie: 'monitor.webp',
	christophe: 'monitor.webp',
	badis: 'monitor.webp',
	kevin: 'monitor.webp',
	guillaume: 'monitor.webp',
	dominique: 'monitor.webp',
}
---

<section id='planning' class='courses'>
	<LogoOutline class='courses-logo courses-logo-right' />
	<LogoOutline class='courses-logo courses-logo-left' />
	<div class='title'>
		<HeaderBefore />
		<h2>Le planning des<br /> prochains cours</h2>
		<HeaderAfter />
	</div>
	<table class='planning'>
		<thead>
			<tr>
				<th>Date</th>
				<th>Horaire</th>
				<th>Cours</th>
				<th>Moniteurs</th>
			</tr>
		</thead>
		<tbody>
			{
				days.map(({ date, courses }) =>
					courses.map((course, index) => (
					<tr>
						{index === 0 && (
							<td class='date' rowspan={courses.length}>
								{formatDate(date)}
							</td>
						)}
						<td>{course.hour_interval}</td>
						<td>
							<span
								class:list={['course-name', courseColor[course.courseName]]}
							>
								{course.courseName}
							</span>
						</td>
						<td class='monitors'>
							{/* Avatars hidden until we have everyone's photo
							<div class='avatars'>
								{course.teachers.map((monitor) => (
									<img
										class='avatar'
										src={`/images/moniteurs/${monitorAvatars[monitor]}`}
									/>
								))}
							</div>
							*/}
							<span class='names'>
								{course.teachers.map(capitalize).join(' & ')}
							</span>
						</td>
					</tr>
					)),
				)
			}
		</tbody>
	</table>
	<div class='planning-mobile'>
		{
			days.map(({ date, courses }) => (
				<div class='day'>
					<div class='date'>{formatDate(date)}</div>
					{courses.map((course) => (
						<div class='course'>
							<div>{course.hour_interval}</div>
							<div class:list={['course-name', courseColor[course.courseName]]}>
								{course.courseName}
							</div>
							<div class='monitors'>
								{/* Avatars hidden until we have everyone's photo
								<div class='avatars'>
									{course.teachers.map((monitor) => (
										<img
											class='avatar'
											src={`/images/moniteurs/${monitorAvatars[monitor]}`}
										/>
									))}
								</div>
								*/}
								<span class='names'>
									{course.teachers.map(capitalize).join(' & ')}
								</span>
							</div>
						</div>
					))}
				</div>
			))
		}
	</div>
	<p>
		Le planning est mis à jour chaque semaine en fonction des moniteurs
		disponibles.
	</p>
	<Button href='/inscription#adhesion'>Voir le planning et les tarifs</Button>
</section>

<style scoped lang='scss'>
	@use '../styles/colors';
	@use '../styles/gutters';
	@use '../styles/borders';
	@use '../styles/fonts';

	.courses {
		background-color: colors.$main-light;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: gutters.$extra-extra-large;
		padding-block: 5rem;
		position: relative;
		overflow: hidden;
		> * {
			position: relative;
			z-index: 1;
		}
		> :global(.courses-logo) {
			position: absolute;
			z-index: 0;
			width: 90rem;
		}
		> :global(.courses-logo-right) {
			top: -10%;
			right: -55rem;
			transform: rotate(-30deg);
		}
		> :global(.courses-logo-left) {
			bottom: -20%;
			left: -60rem;
			transform: rotate(20deg);
		}
		.title {
			display: flex;
			gap: gutters.$normal;
			h2 {
				text-align: center;
				font-family: fonts.$family-title;
				font-size: fonts.$title;
				line-height: fonts.$title;
				font-weight: 400;
				::before {
					content: url('../icons/header-before.astro');
				}
			}
		}
		.date {
			text-transform: capitalize;
			background-color: colors.$table-row;
		}
		.course-name {
			display: block;
			margin: auto;
			padding: gutters.$extra-small gutters.$normal;
			border-radius: borders.$radius;
			background-color: colors.$white;
			font-weight: bold;
			width: fit-content;
		}
		.green {
			background-color: colors.$main-light;
		}
		.orange {
			background-color: colors.$accent-light;
		}
		.red {
			background-color: colors.$red;
		}
		.blue {
			background-color: colors.$blue;
		}
		.neutral {
			background-color: colors.$main-lighter;
		}
		.monitors {
			display: flex;
			align-items: center;
			gap: gutters.$normal;
			justify-content: center;
		}
		.avatars {
			display: flex;
			align-items: center;
			margin-right: 1rem;
			.avatar {
				width: 3rem;
				height: 3rem;
				border-radius: 50%;
				border: 2px solid colors.$white;
				margin-right: -1rem;
				object-fit: cover;
			}
		}
		.planning {
			padding: gutters.$large;
			border-radius: borders.$radius;
			background-color: colors.$white;
			text-align: center;
			width: gutters.$small-max-width;
			tbody > tr:nth-child(2n) {
				background-color: colors.$table-row;
			}
			tbody > tr:nth-child(2n + 1) {
				background-color: colors.$background;
			}
			td,
			th {
				border: 2px solid colors.$white;
				padding-block: gutters.$normal;
				padding-inline: gutters.$small;
			}
			// monitors are left-aligned (header included) while the other columns stay centred
			th:last-child {
				text-align: left;
			}
			td.monitors {
				justify-content: flex-start;
			}
		}
		.planning-mobile {
			display: none;
		}
	}

	@media (max-width: 1440px) {
		.courses {
			width: 100%;
			padding-inline: 1rem;
			> :global(.courses-logo) {
				width: 36rem;
			}
			> :global(.courses-logo-right) {
				top: 12%;
				right: -22rem;
			}
			> :global(.courses-logo-left) {
				bottom: 6%;
				left: -20rem;
			}
			.title h2 {
				font-size: fonts.$title-mobile;
				line-height: fonts.$title-mobile;
			}
			.planning {
				display: none;
			}
			.planning-mobile {
				width: 100%;
				display: flex;
				flex-direction: column;
				border: borders.$button;
				border-radius: borders.$radius;
				overflow: hidden;
				.day {
					display: flex;
					flex-direction: column;
					> *:nth-child(2n + 1) {
						background-color: colors.$table-row;
					}
					> *:nth-child(2n) {
						background-color: colors.$background;
					}
					& + .day {
						border-top: borders.$button;
					}
				}
				.date {
					padding: gutters.$extra-large;
					text-align: center;
					font-weight: bold;
					font-size: 1.25rem;
				}
				.course {
					padding: gutters.$extra-large;
					display: flex;
					flex-direction: column;
					align-items: center;
					gap: gutters.$normal;
				}
			}
			p {
				text-align: center;
			}
		}
	}
</style>
