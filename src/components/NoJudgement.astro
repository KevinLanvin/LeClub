---
import Button from './atoms/Button.astro'

const { class: className } = Astro.props
---

<div class:list={['action-card', className]}>
	<div class='titles'>
		<h4>Vous êtes guidés à chaque étape.</h4>
		<h4>Chacun avance à son rythme</h4>
	</div>
	<p>
		Ici on vient autant pour apprendre que pour passer un bon moment avec son
		chien ! Le club repose sur l'entraide, l'échange et le plaisir de progresser
		ensemble !
	</p>
	<div class='actions'>
		<Button>Participer à la première séance</Button>
		<Button inverted>Voir le planning</Button>
	</div>
</div>

<style scoped lang='scss'>
	@use '../styles/colors';
	@use '../styles/gutters';
	@use '../styles/borders';
	@use '../styles/fonts';

	.action-card {
		background-color: colors.$white;
		padding: gutters.$extra-large;
		border-radius: borders.$radius;
		display: flex;
		flex-direction: column;
		gap: gutters.$extra-large;
		align-items: start;
		text-align: start;
		.titles {
			display: flex;
			flex-direction: column;
			align-items: start;
			font-family: fonts.$family-title;
			font-size: fonts.$subtitle;
			line-height: fonts.$subtitle;
			gap: gutters.$small;
			h4 {
				font-weight: 400;
			}
		}
		.actions {
			width: 100%;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: gutters.$large;
		}
	}
</style>
