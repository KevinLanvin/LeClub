---
import Facebook from '../icons/facebook.astro'
---

<footer>
	<div class='content'>
		<div class='about'>
			<img src='/images/logo-club.svg' alt='Logo Le Club Téteghem' />
			<p>
				Club canin de Téteghem : éducation, activités et rééducation pour vous
				et votre chien.
			</p>
			<div class='facebook'>
				<strong>Suivez-nous sur :</strong>
				<a
					href='https://www.facebook.com/groups/1000283000064259/'
					target='_blank'
					rel='noopener noreferrer'
					aria-label='Facebook'><Facebook /></a
				>
			</div>
		</div>
		<div class='links'>
			<strong>Nos partenaires</strong>
			<a
				href='https://ofblueridgemountains.chiens-de-france.com/berger-australien'
				target='_blank'
				rel='noopener noreferrer'>Élevage Blue Ridge Mountain</a
			>
		</div>
		<div class='address'>
			<strong>Adresse</strong>
			<p>137 Route de Furnes<br />59229 Téteghem-Coudekerque-Village</p>
			<p>Le samedi de 9h à 16h</p>
		</div>
	</div>
	<p class='copyright'>Copyright © Design fait avec ♥ par MGDG</p>
</footer>

<style scoped lang='scss'>
	@use '../styles/colors';
	@use '../styles/gutters';
	@use '../styles/fonts';

	footer {
		width: 100%;
		background-color: colors.$main;
		color: colors.$white;
		padding: gutters.$extra-large gutters.$normal;
		display: flex;
		flex-direction: column;
		gap: gutters.$extra-large;
		align-items: center;
		font-size: fonts.$small;
		line-height: 22px;

		strong {
			font-size: fonts.$regular;
		}

		.content {
			width: gutters.$small-max-width;
			display: flex;
			gap: gutters.$extra-extra-large;
			justify-content: space-between;
		}

		.about {
			flex: 1.5;
			display: flex;
			flex-direction: column;
			gap: gutters.$large;
			img {
				width: 198px;
				filter: brightness(0) invert(1);
			}
			.facebook {
				display: flex;
				align-items: center;
				gap: gutters.$normal;
				:global(path) {
					fill: colors.$white;
				}
			}
		}

		.links,
		.address {
			flex: 1;
			display: flex;
			flex-direction: column;
			gap: gutters.$normal;
		}

		.links a {
			text-decoration: underline;
		}

		.copyright {
			font-size: 12px;
			line-height: 12px;
			text-align: center;
			width: gutters.$small-max-width;
			padding-top: gutters.$normal;
			border-top: 1px solid colors.$white;
		}
	}

	@media (max-width: 1440px) {
		footer {
			.content {
				width: gutters.$mobile-width;
				flex-direction: column;
			}
			.copyright {
				width: gutters.$mobile-width;
			}
		}
	}
</style>
