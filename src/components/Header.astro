---
import Button from './atoms/Button.astro'
---

<div class='disclaimer'>
	Premier cours d’essai gratuit (carnet de vaccination obligatoire) !
</div>
<header class='header'>
	<nav class='nav'>
		<a href='/' class='logo'>
			<img src='/images/logo-club.png' alt='Logo' />
		</a>
		<div class='header__desktop'>
			<a href='/le-club'>Le Club</a>
			<a href='activites'>Les Activités</a>
			<a href=''>Planning</a>
		</div>
		<div class='actions'>
			<Button>S'inscrire</Button>
			<Button inverted>Contact</Button>
		</div>
		<div class='header__mobile'>
			<input type='checkbox' id='hamburger-toggle' />
			<label class='header__hamburger' for='hamburger-toggle'>
				<span></span>
				<span></span>
				<span></span>
				<span></span>
			</label>
		</div>
		<div id='menuMobile' class='header__mobile-menu hidden'>
			<label class='header__mobile-menu-close' for='hamburger-toggle'
				>&#x2715;</label
			>
			<a href='/le-club'>Le Club</a>
			<div class='expandable'>
				<span>Les Activités</span>
				<div class='submenu'>
					<a href='chiots'>Ecole du chiot</a>
					<a href='education'>Education</a>
					<a href='agility'>Agility</a>
					<a href='obeissance'>Obéissance</a>
				</div>
			</div>
			<a href=''>Planning</a>
		</div>
	</nav>
</header>

<script>
	const menuMobile = document.getElementById('menuMobile')
	document
		.getElementById('hamburger-toggle')
		?.addEventListener('change', () => menuMobile?.classList.toggle('hidden'))
</script>

<style scoped lang='scss'>
	@use '../styles/colors';
	@use '../styles/gutters';
	@use '../styles/borders';
	@use '../styles/fonts';
	@use '../styles/shadows';

	.disclaimer {
		background-color: colors.$main;
		color: colors.$white;
		padding: gutters.$small;
		display: flex;
		justify-content: center;
		font-family: Poppins;
		font-weight: bold;
		font-size: fonts.$small;
		text-align: center;
	}
	.header {
		background-color: colors.$white;
		position: sticky;
		top: 0;
		z-index: 9999;
		.nav {
			max-width: gutters.$max-width;
			margin: auto;
			z-index: 9999;
			display: flex;
			justify-content: center;
			align-items: center;
			padding: 0 gutters.$normal;
			color: colors.$text;
			height: 5rem;
			.logo {
				width: 25%;
				height: 100%;
				margin-right: auto;
				padding-block: gutters.$small;
				img {
					object-fit: contain;
					height: 100%;
				}
			}
			.actions {
				margin-left: auto;
				width: 25%;
				display: flex;
				justify-content: flex-end;
				gap: gutters.$normal;
			}
			.header__desktop {
				height: 100%;
				display: flex;
				align-items: stretch;
				gap: gutters.$extra-large;
				> * {
					line-height: 5rem;
					vertical-align: middle;
				}
				a:hover {
					color: colors.$accent;
				}
				.expandable {
					cursor: pointer;
					position: relative;
					&:hover .submenu {
						display: flex;
						align-items: stretch;
					}
				}
				.submenu {
					position: absolute;
					top: 100%;
					left: 50%;
					transform: translateX(-50%);
					width: auto;
					display: none;
					flex-direction: column;
					align-items: center;
					justify-content: space-around;
					padding: gutters.$small 0;
					background-color: colors.$white;
					border-radius: borders.$radius;
					box-shadow: shadows.$card;
					line-height: 1rem;
					a {
						text-align: center;
						text-wrap: nowrap;
						color: colors.$text;
						padding: gutters.$normal 4rem;
						font-weight: 300;
						&:hover {
							color: colors.$accent;
						}
					}
				}
			}
			.header__mobile-menu {
				display: none;
			}
		}
	}
	.active {
		color: colors.$accent;
	}

	.header__mobile {
		display: none;
	}

	@media (max-width: 1440px) {
		.header {
			.nav {
				height: 5rem;
				.header__desktop {
					display: none;
				}
				.actions {
					display: none;
				}
				.header__hamburger {
					width: 3.6rem;
					height: 3.25rem;
					position: relative;
					cursor: pointer;
					padding: 1rem;
					margin-right: -1rem;
					align-self: center;
					span {
						display: block;
						position: absolute;
						margin-left: 0;
						width: 1.6rem;
						height: 0.125rem;
						background-color: colors.$text;
						border-radius: 0.1rem;
						transition:
							transform 0.2s ease,
							background-color 0.2s ease;
						&:nth-child(1) {
							top: 1;
						}
						&:nth-child(2) {
							top: 1.5rem;
						}
						&:nth-child(3) {
							top: 1.5rem;
						}
						&:nth-child(4) {
							top: 2rem;
						}
					}
				}

				#hamburger-toggle {
					display: none;
					&:checked {
						+ .header__hamburger span {
							background-color: colors.$text;
							&:nth-child(1) {
								transform: scaleX(0.01) translateY(0.6rem);
							}
							&:nth-child(2) {
								transform: rotate(45deg);
							}
							&:nth-child(3) {
								transform: rotate(-45deg);
							}
							&:nth-child(4) {
								transform: scaleX(0.01) translateY(-0.6rem);
							}
						}
					}
				}

				.header__desktop {
					display: none;
				}

				.header__mobile {
					display: flex;
					align-items: center;
				}

				.header__mobile-menu {
					display: flex;
					flex-direction: column;
					gap: 2rem;
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					bottom: 0;
					z-index: 10000;
					background-color: colors.$white;
					transform: translateX(0);
					transition: transform 0.3s;
					padding: gutters.$large;
					overflow-y: auto;
					.header__mobile-menu-close {
						align-self: flex-end;
						cursor: pointer;
						font-size: 1.5rem;
						line-height: 1;
						padding: 0.25rem 0.5rem;
						margin-bottom: gutters.$small;
					}
					span {
						margin: 0;
						& > a {
							padding: gutters.$small;
							padding-left: 0;
							height: auto;
							line-height: 1.5rem;
						}
					}
					.submenu {
						padding-left: gutters.$small;
						padding-top: gutters.$small;
						display: flex;
						flex-direction: column;
						justify-content: space-around;
						gap: gutters.$small;
					}
				}
				.header__mobile-menu.hidden {
					transform: translateX(150%);
				}
			}
		}
	}
</style>
