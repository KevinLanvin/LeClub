---
import Card from './atoms/Card.astro'
---

<section class='activities'>
	<div class='title'>
		<h3>Activités d'éducation canine à Teteghem</h3>
		<h2>
			On <span class='accent'>s'adapte</span> à votre chien & à chaque situation
		</h2>
	</div>
	<div class='grid'>
		<Card
			title='Ecole du chiot'
			description='Socialisation, premiers apprentissages et découverte du monde en douceur'
			image='/images/chiot.jpg'
			imageAlt='Chiot'
			details='Dès 2 mois'
		/>
		<Card
			title='Education canine'
			description='Apprendre les bases utiles au quotidien'
			image='/images/education.jpg'
			imageAlt='Education'
			details='Dès 6 mois, ouvert à tous'
		/>
		<Card
			title='Obéissance'
			description='Pour aller plus loin et découvrir des disciplines sportives'
			image='/images/obedience.jpg'
			imageAlt='Obéissance'
			details="Niveau minimal d'éducation requis"
		/>
		<Card
			title='Agility'
			description='Pour se dépenser et découvrir ce sport très dynamique !'
			image='/images/agility.jpg'
			imageAlt='Agility'
			details='Dès 1 an'
		/>
	</div>
</section>

<style lang='scss' scoped>
	@use '../styles/colors';
	@use '../styles/borders';
	@use '../styles/gutters';

	.activities {
		display: grid;
		gap: gutters.$extra-extra-large;
		grid-template-columns: 2fr 5fr;
		max-width: calc(gutters.$max-width - 10rem);
		margin: auto;
		.title {
			display: flex;
			flex-direction: column;
			gap: gutters.$large;
			h3 {
				text-transform: uppercase;
				font-size: 1rem;
				line-height: 1rem;
				font-weight: 300;
				color: colors.$text;
			}
			h2 {
				font-size: 3rem;
				font-family: Jomolhari;
				font-weight: 400;
				line-height: 3rem;
				.accent {
					color: colors.$accent;
				}
			}
		}
		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: gutters.$large;
		}
	}

	@media (max-width: 1440px) {
		.activities {
			max-width: 100%;
			grid-template-columns: 1fr;
			padding: gutters.$normal;
			gap: 5rem;
		}
	}
</style>
