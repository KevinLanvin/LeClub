---
const { inverted = false, href, ...attrs } = Astro.props
const Tag = href ? 'a' : 'button'
---

<Tag href={href} class:list={['button', { inverted }]} {...attrs}>
	<slot />
</Tag>

<style lang='scss' scoped>
	@use '../../styles/colors';
	@use '../../styles/borders';
	@use 'sass:color';

	.button {
		display: inline-block;
		text-align: center;
		text-decoration: none;
		font-size: 13.3333px;
		line-height: normal;
		background-color: colors.$accent-lighter;
		color: white;
		padding: 12px 20px;
		border: none;
		border-radius: borders.$radius-small;
		cursor: pointer;
		&:hover {
			background-color: color.adjust(colors.$accent-lighter, $lightness: -10%);
		}
	}
	.button.inverted {
		background-color: transparent;
		color: colors.$accent-lighter;
		border: borders.$button;
		&:hover {
			border-color: color.adjust(colors.$accent-lighter, $lightness: -10%);
			color: color.adjust(colors.$accent-lighter, $lightness: -10%);
		}
	}
</style>
