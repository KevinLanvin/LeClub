---
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import '../styles/main.scss'
const { title } = Astro.props
---

<html>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width,initial-scale=1' />
		<title>{title}</title>
		<script
			is:inline
			src='https://identity.netlify.com/v1/netlify-identity-widget.js'></script>
		<link rel='preconnect' href='https://fonts.googleapis.com' />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
		<link
			href='https://fonts.googleapis.com/css2?family=Jomolhari&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap'
			rel='stylesheet'
		/>
	</head>
	<slot name='head' />

	<body>
		<Header />
		<main class='content'>
			<slot />
		</main>
		<Footer />
		<script>
			if (window.netlifyIdentity) {
				window.netlifyIdentity.on('init', (user) => {
					if (!user) {
						window.netlifyIdentity.on('login', () => {
							document.location.href = '/admin/index.html'
						})
					}
				})
			}
		</script>
	</body>

	<style>
		.content {
			overflow: hidden;
		}
	</style>


</html>
